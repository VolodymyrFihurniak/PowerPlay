{
  "name": "power-play-server",
  "version": "1.0.0",
  "scripts": {
    "dev": "bun --inspect --watch src/server.ts",
    "build": "bun build src/server.ts",
    "start": "NODE_ENV=production bun src/server.ts",
    "test": "bun test",
    "lint": "eslint --fix \"src/**/*.ts\" && tsc --noEmit",
    "lint:prettier": "prettier --write \"src/**/*.ts\"",
    "seed": "bun x prisma db seed"
  },
  "prisma": {
    "seed": "ts-node scripts/seed.ts"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.1.0",
    "@elysiajs/jwt": "^1.1.0",
    "@elysiajs/swagger": "^1.1.1",
    "@prisma/client": "5.18.0",
    "bcrypt": "^5.1.1",
    "elysia": "^1.1.5",
    "googleapis": "^140.0.1",
    "log4js": "^6.9.1",
    "nodemailer": "^6.9.14",
    "uuid": "^10.0.0",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@trivago/prettier-plugin-sort-imports": "^4.3.0",
    "@types/bcrypt": "^5.0.2",
    "@types/bun": "^1.1.6",
    "@types/eslint__js": "^8.42.3",
    "@types/nodemailer": "^6.4.15",
    "@types/uuid": "^10.0.0",
    "bun-types": "^1.1.22",
    "eslint": "^9.9.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "globals": "^15.9.0",
    "prettier": "^3.3.3",
    "prisma": "^5.18.0",
    "ts-node": "^10.9.2",
    "typescript-eslint": "^8.1.0"
  },
  "module": "src/server.js"
}
