{
  "name": "power-play-server",
  "version": "1.0.0",
  "scripts": {
    "dev": "bun --watch src/app.ts",
    "build": "bun build src/app.ts",
    "start": "NODE_ENV=production bun src/app.ts",
    "test": "bun test",
    "lint": "eslint --fix \"src/**/*.ts\" && tsc --noEmit",
    "lint:prettier": "prettier --write \"src/**/*.ts\"",
    "seed": "bun x prisma db seed"
  },
  "prisma": {
    "seed": "ts-node scripts/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "5.15.0",
    "elysia": "latest",
    "log4js": "^6.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.5.0",
    "@trivago/prettier-plugin-sort-imports": "^4.3.0",
    "@types/eslint__js": "^8.42.3",
    "bun-types": "latest",
    "eslint": "^9.5.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "globals": "^15.5.0",
    "prettier": "^3.3.2",
    "prisma": "^5.15.0",
    "ts-node": "^10.9.2",
    "typescript-eslint": "^7.13.0"
  },
  "module": "src/app.js"
}
