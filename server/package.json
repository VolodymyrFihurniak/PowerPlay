{
  "name": "power-play-server",
  "version": "1.0.0",
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "build": "bun build src/server.ts",
    "start": "NODE_ENV=production bun src/server.ts",
    "test": "bun test",
    "lint": "eslint --fix \"src/**/*.ts\" && tsc --noEmit",
    "lint:prettier": "prettier --write \"src/**/*.ts\"",
    "seed": "bun x prisma db seed"
  },
  "prisma": {
    "seed": "ts-node scripts/seed.ts"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.1.0",
    "@elysiajs/jwt": "^1.1.0",
    "@elysiajs/swagger": "^1.1.0",
    "@prisma/client": "5.17.0",
    "elysia": "^1.1.3",
    "log4js": "^6.9.1",
    "yaml": "^2.4.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.7.0",
    "@trivago/prettier-plugin-sort-imports": "^4.3.0",
    "@types/bun": "^1.1.6",
    "@types/eslint__js": "^8.42.3",
    "bun-types": "^1.1.20",
    "eslint": "^9.7.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "globals": "^15.8.0",
    "prettier": "^3.3.3",
    "prisma": "^5.17.0",
    "ts-node": "^10.9.2",
    "typescript-eslint": "^7.16.1"
  },
  "module": "src/server.js"
}
